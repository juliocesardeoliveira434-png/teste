{
  "name": "gangue-jornal-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord autocontido para jornalismo competitivo entre gangues.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "dotenv": "18.0.8",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.0.8"
  }
}
