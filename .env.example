# Obrigatório — token gerado no Discord Developer Portal. Nunca publique este valor.
DISCORD_TOKEN=
# Obrigatório — Application ID da aplicação Discord.
CLIENT_ID=
# Obrigatório — ID do único servidor onde o bot funcionará.
GUILD_ID=
# Opcional — caminho do SQLite criado automaticamente no ambiente do cliente.
DATABASE_PATH=./data/bot.sqlite
# Opcional — trace, debug, info, warn ou error.
LOG_LEVEL=info
